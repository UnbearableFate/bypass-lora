+def test_collision_redraw_with_tiny_pool(tok, pools, tmp_path):
+    # Two names give 2*4*2 = 16 E=1 contents: evaluation rows must redraw, train may repeat.
+    tiny = dict(pools, pools={'seen': pools['pools']['seen'][:2], 'unseen': []})
