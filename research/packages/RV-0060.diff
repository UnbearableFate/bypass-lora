     "KernelSlotReference", "SoftmaxSlot", "CenteredCosineSlot", "centered_cosine_scores",
     "LatentReader", "SequenceResult",
-    "process_sequence",
+    "process_sequence", "process_prefix", "kernel_prefix_states", "read_kernel_prefix",
+    "process_kernel_tokenwise",
 ]
 
