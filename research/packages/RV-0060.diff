+                    2 if label=='RB1-03' else 4 if label in ('RB1-04','RB1-05','RB1-06') else 1)
+                assert counts['writes']==sum(tokens) and counts['reads']==sum(tokens)*depth
+    assert all(t==token_sequences[0] for t in token_sequences)
