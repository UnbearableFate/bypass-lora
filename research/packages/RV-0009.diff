+def assert_memory_close(actual, expected):
+    for name in ('M', 'c', 'slot_keys', 'slot_values', 'slot_valid', 'counts'):
+        a, b = getattr(actual, name), getattr(expected, name)
+        if b is None:
+            assert a is None
+        else:
