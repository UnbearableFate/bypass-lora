+| C_dual | 917504 | 596967424 | .210398 | 5.166461 | 5.683372 |
+| linear | 917504 | 596967424 | .217786 | 5.012502 | 5.252097 |
+| LoRA4 | 901120 | 596951040 | .223529 | 4.879263 | 5.293577 |
+| LoRA28 | 1261568 | 597311488 | .435291 | 8.368681 | 8.515534 |
