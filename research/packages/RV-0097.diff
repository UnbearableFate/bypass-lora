+++ b/src/seg_a2_lock.py
@@ -0,0 +1,104 @@
+"""PBS-only E-0030 pre-opening audit and lock creation; no A2 field access."""
+import argparse
+import os
+from pathlib import Path
+import time
+
+from calibrate import REVISION
+from rb1_artifacts import read, reference
+from rb_data import BASE_SEED, STUDY
+from seg_a2_data import CONTRACT, SEEDS, ARMS, EVALUATION, BOOTSTRAP, SPLIT_MANIFEST_SHA256, verify_lock
+from seg_a2_rules import IMPLEMENTATION_CHECKS
+from seg_artifacts import validate
+from v1_data import derive_seed
+from v5_train import write_json
+
+
+def make_lock(inputs):
+    source = os.environ['SR_CODE_COMMIT']
+    if inputs['training_source'] != source:
+        raise ValueError('training/evaluation/analysis source must be the same reviewed commit')
+    checks_ref = inputs['deterministic_checks']; smoke_ref = inputs['smoke']
+    for ref in (checks_ref, smoke_ref):
+        if reference(ref['path']) != ref:
+            raise ValueError('preopening check or smoke reference changed')
+        check = read(ref['path'])
+        if check.get('status') != 'complete' or check.get('validator', {}).get('passed') is not True:
+            raise ValueError('preopening test or smoke job did not pass')
+    deterministic = read(checks_ref['path'])
+    if (deterministic.get('source_commit') != source or
+            deterministic['metrics'].get('no_channel_identity') is not True or
+            deterministic['metrics'].get('no_channel_seeds') != list(SEEDS)):
+        raise ValueError('no-channel checks are not at the final reviewed source for all seeds')
+    smoke = read(smoke_ref['path'])
+    if smoke['metrics'].get('preopening.loader_equivalence_seeds') != [0, 1, 2]:
+        raise ValueError('masking loader lacks legacy plan/exclusion equivalence checks')
+    exclusion_ref = smoke['metrics']['preopening.excluded_audit_reference']
+    if reference(exclusion_ref['path']) != exclusion_ref:
+        raise ValueError('registered exclusion audit reference changed')
+    split_ref = reference(inputs['split_manifest'])
+    if split_ref['sha256'] != SPLIT_MANIFEST_SHA256:
+        raise ValueError('A2 IDs file differs from the sealed manifest')
+    split = read(split_ref['path'])
+    runs, checks = {}, {}
+    for seed in SEEDS:
+        roots = inputs['runs'][str(seed)]
+        if set(roots) != set(ARMS):
+            raise ValueError('exactly four arms per seed required')
+        runs[str(seed)] = {}; manifests = {}
+        for arm in ARMS:
+            root = Path(roots[arm]).resolve()
+            manifest, _, _ = validate(root, arm, source, seed)
+            manifests[arm] = manifest
+            train_ids = {(r['task'], r['id']) for r in read(root/'seams-train.json')}
+            held = {(t, i) for t, ids in split['ids'].items() for i in ids}
+            if train_ids & held:
+                raise ValueError('training rows overlap held A2 IDs')
+            if read(root/'excluded-train.json') != read(smoke['metrics']['preopening.excluded_audit_reference']['path']):
+                raise ValueError('training exclusion audit differs from E-0027')
+            runs[str(seed)][arm] = {'root': str(root), 'manifest': reference(root/'manifest.json'),
+                'predictions': reference(root/'predictions.json'), 'checkpoint': read(root/'checkpoint.json')}
+        initial = {a: m['metrics']['initial.adapter_sha256'] for a, m in manifests.items()}
+        check = {k: True for k in IMPLEMENTATION_CHECKS}
+        check['initial_parameters_identical'] = initial['SEG-05'] == initial['SEG-06'] == initial['SEG-07']
+        if not all(check.values()):
+            raise ValueError('initial parameter identity failed')
+        checks[str(seed)] = check
+    return {'contract': CONTRACT, 'evaluation_source': source, 'training_source': source,
+        'model_revision': REVISION, 'tokenizer_revision': REVISION,
+        'split_manifest': split_ref, 'ids_sha256': split['ids_sha256'], 'runs': runs,
+        'evaluation': EVALUATION, 'bootstrap': BOOTSTRAP,
+        'derangement': {'seed': derive_seed(BASE_SEED, STUDY, 'A2', 'iv_swap'),
+                        'method': 'within_task_fixed_derangement'},
+        'preopening_checks': {'passed': True, 'checks': checks, 'deterministic': checks_ref, 'smoke': smoke_ref,
+            'rules': {'2': 'same slice exact dev rows; other slice <=10 class mismatches; A2 off equals same-job Base',
+                      '3': 'gain_s=Keep-max(Reset,T0); lora_s=Keep-LoRA; swap_s=Keep-swap',
+                      '4': '10000 paired BoolQ row draws shared by all arms/seeds; recompute maximum; linear quantile',
+                      '5': 'G>0 and lower95>0 -> supported; G<=0 -> challenged; otherwise inconclusive',
+                      '6': 'only after primary support: L>0 and lower95>0 confirms LoRA comparison'}}}
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--input', type=Path, required=True)
+    p.add_argument('--output', type=Path, required=True)
+    args = p.parse_args(); out = args.output.resolve(); out.mkdir(parents=True, exist_ok=True)
+    passed, start = False, time.monotonic()
+    try:
+        lock = make_lock(read(args.input))
+        write_json(out/'a2-lock.json', lock)
+        sha = reference(out/'a2-lock.json')['sha256']
+        verify_lock(out/'a2-lock.json', sha)
+        (out/'a2-lock.sha256').write_text(sha+'\n')
+        passed = True
+    finally:
+        write_json(out/'manifest.json', {'status': 'complete' if passed else 'partial', 'contract': CONTRACT,
+            'stage': 'preopening_lock', 'source_commit': os.environ['SR_CODE_COMMIT'],
+            'spec_digest': os.environ['SR_SPEC_DIGEST'],
+            'metrics': {'preopening.passed': passed, 'confirmation_evaluated': False, 'elapsed_s': time.monotonic()-start},
+            'artifacts': [{'path': str(f), 'role': f.name} for f in out.iterdir() if f.is_file() and f.name != 'manifest.json'],
+            'validator': {'name': 'E0030_preopening_lock', 'passed': passed}})
+
+
+if __name__ == '__main__':
+    main()
diff --git a/src/seg_a2_predata.py b/src/seg_a2_predata.py
new file mode 100644
index 0000000..150b2fa
--- /dev/null
+++ b/src/seg_a2_predata.py
@@ -0,0 +1,187 @@
+"""Pre-opening V1 data preparation that never materializes sealed A2 fields.
+
+The fixed source files are hashed as bytes first. Rows whose IDs are in the
+sealed A2 manifest become ID-only placeholders; PIQA JSON and labels are not
+decoded for them, and BoolQ parquet columns are filtered before ``to_pylist``.
+"""
+import hashlib
+import json
+from pathlib import Path
+
+from rb_data import apply_confirmation
+from v1_data import make_v1_splits
+
+PIQA_SHA256 = 'f805f9c96518d7b59f2f870d90f712457cda949979469d9fa3fd706ce22e0a1a'
+PIQA_LABELS_SHA256 = 'df8ae080c41f02f88e81f6932d425f4b7ee72f433ad552e6a30d45e358e8f8bb'
+BOOLQ_SHA256 = '4f028e992c0bd4df30b9f056f4946b64f5c23028034ff0ed5ea467d8538cc623'
+SPLIT_MAPPING_SHA256 = '47cf5c777d07863b8def6903487697eafc970b0cd5b5d80babb7f20ded98571b'
+CONFIRMATION_MANIFEST_SHA256 = '34277aa4627271dbf4e0bcb9592e3014c6130d87b1766caad17c2d6b97a8a7cc'
+SOURCES = {
+    'piqa': {'repo': 'ybisk/ybisk.github.io',
+             'revision': '21edab439af693b961be2f069e8690a88d3b4e37'},
+    'boolq': {'repo': 'google/boolq',
+              'revision': '35b264d03638db9f4ce671b711558bf7ff0f80d5'},
+}
+
+
+def _sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open('rb') as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b''):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _nonblank_lines(path):
+    with Path(path).open('r', encoding='utf-8') as handle:
+        for line in handle:
+            value = line.strip()
+            if value:
+                yield value
+
+
+def _piqa_records(jsonl_lines, label_lines, held_ids):
+    """Parse allowed PIQA rows, substituting ID-only placeholders for held IDs."""
+    held_ids = set(held_ids)
+    rows = []
+    labels = iter(label_lines)
+    for line in jsonl_lines:
+        if not line.strip():
+            continue
+        try:
+            label_text = next(labels)
+        except StopIteration as exc:
+            raise ValueError('PIQA row/label count mismatch') from exc
+        row_id = len(rows)
+        if row_id in held_ids:
+            rows.append({'task': 'piqa', 'id': row_id})
+            continue
+        try:
+            value = json.loads(line)
+        except json.JSONDecodeError as exc:
+            raise ValueError(f'PIQA row {row_id} is not valid JSON') from exc
+        if not isinstance(value, dict):
+            raise ValueError(f'PIQA row {row_id}: expected a JSON object')
+        try:
+            label = int(label_text)
+        except (TypeError, ValueError) as exc:
+            raise ValueError(f'PIQA label {row_id} is not an integer') from exc
+        if label not in (0, 1):
+            raise ValueError(f'PIQA label {row_id} must be 0 or 1')
+        if not all(isinstance(value.get(key), str) for key in ('goal', 'sol1', 'sol2')):
+            raise ValueError(f'PIQA row {row_id} is missing string goal/sol1/sol2 fields')
+        rows.append({'task': 'piqa', 'id': row_id, 'goal': value['goal'],
+                     'solutions': [value['sol1'], value['sol2']], 'label': label})
+    try:
+        next(labels)
+    except StopIteration:
+        pass
+    else:
+        raise ValueError('PIQA row/label count mismatch')
+    return rows
+
+
+def _boolq_record(row, row_id):
+    if not isinstance(row.get('passage'), str) or not isinstance(row.get('question'), str):
+        raise ValueError(f'BoolQ row {row_id} is missing string passage/question fields')
+    answer = row.get('answer')
+    if not isinstance(answer, bool):
+        raise ValueError(f'BoolQ row {row_id} answer must be a JSON boolean')
+    return {'task': 'boolq', 'id': row_id, 'passage': row['passage'],
+            'question': row['question'], 'label': answer}
+
+
+def _boolq_records_parquet(table, held_ids):
+    """Filter Arrow rows before Python conversion, reading only ID values first."""
+    import pyarrow as pa
+
+    if 'id' in table.column_names:
+        ids = table['id'].to_pylist()
+    else:
+        ids = list(range(table.num_rows))
+    if len(ids) != table.num_rows:
+        raise ValueError('BoolQ Arrow ID count differs from row count')
+    held_ids = set(held_ids)
+    keep = [row_id not in held_ids for row_id in ids]
+    allowed = iter(table.filter(pa.array(keep, type=pa.bool_())).to_pylist())
+    result = []
+    for row_id in ids:
+        if row_id in held_ids:
+            result.append({'task': 'boolq', 'id': row_id})
+        else:
+            result.append(_boolq_record(next(allowed), row_id))
+    try:
+        next(allowed)
+    except StopIteration:
+        pass
+    else:
+        raise ValueError('BoolQ Arrow filtering returned extra rows')
+    return result
+
+
+def _read_boolq(path, held_ids):
+    path = Path(path)
+    if path.suffix.lower() != '.parquet':
+        raise ValueError('pre-opening BoolQ reader requires the pinned parquet source')
+    try:
+        import pyarrow.parquet as parquet
+    except ImportError as exc:
+        raise RuntimeError('reading BoolQ parquet requires pyarrow') from exc
+    return _boolq_records_parquet(parquet.read_table(path), held_ids)
+
+
+def _read_manifest(path):
+    path = Path(path)
+    if _sha256(path) != CONFIRMATION_MANIFEST_SHA256:
+        raise ValueError('A2 ID manifest differs from the sealed D-0025 file')
+    manifest = json.loads(path.read_text(encoding='utf-8'))
+    if manifest.get('sealed') is not True or manifest.get('model_evaluated') is not False:
+        raise ValueError('A2 ID manifest is not sealed or records model evaluation')
+    return manifest
+
+
+def prepare_preopening(data_dir, split_manifest):
+    """Build the usual V1 splits while keeping A2 row text/labels inaccessible."""
+    data_dir = Path(data_dir)
+    files = {
+        'piqa': data_dir / 'piqa-train.jsonl',
+        'piqa_labels': data_dir / 'piqa-train-labels.lst',
+        'boolq': data_dir / 'boolq-train.parquet',
+    }
+    expected = {'piqa': PIQA_SHA256, 'piqa_labels': PIQA_LABELS_SHA256,
+                'boolq': BOOLQ_SHA256}
+    for key, path in files.items():
+        if _sha256(path) != expected[key]:
+            raise ValueError(f'source checksum mismatch: {key}')
+    manifest = _read_manifest(split_manifest)
+    if not isinstance(manifest.get('ids'), dict) or set(manifest['ids']) != {'piqa', 'boolq'}:
+        raise ValueError('A2 manifest task ID map is invalid')
+
+    piqa = _piqa_records(_nonblank_lines(files['piqa']),
+                         _nonblank_lines(files['piqa_labels']), manifest['ids']['piqa'])
+    boolq = _read_boolq(files['boolq'], manifest['ids']['boolq'])
+    original = make_v1_splits(
+        piqa, boolq, source_files=files, source_metadata=SOURCES,
+    )
+    if any(original['metadata']['source_files'][key]['sha256'] != digest
+           for key, digest in expected.items()):
+        raise ValueError('source files changed while constructing the V1 split')
+    if original['metadata']['split_mapping_sha256'] != SPLIT_MAPPING_SHA256:
+        raise ValueError('split mapping differs from the pinned V1 mapping')
+    # This regenerates the manifest from IDs alone, compares it exactly, then
+    # removes placeholders and held IDs from the training rows.
+    filtered = apply_confirmation(original, manifest)
+    for task in ('piqa', 'boolq'):
+        if any(not {'task', 'id', 'label'} <= set(row)
+               for row in filtered['splits'][task]['train']):
+            raise ValueError(f'{task} training rows still contain an A2 placeholder')
+    return filtered
+
+
+def load_data(data_dir, split_manifest, tok):
+    """Pre-opening RB-style loader returning filtered splits and audit exclusions."""
+    from v1_data import audit_training_exclusions
+
+    splits = prepare_preopening(data_dir, split_manifest)
+    excluded = audit_training_exclusions(splits, tok)
+    return splits, excluded
diff --git a/src/seg_a2_rules.py b/src/seg_a2_rules.py
new file mode 100644
index 0000000..32faaa7
--- /dev/null
+++ b/src/seg_a2_rules.py
@@ -0,0 +1,218 @@
+"""Pure E-0030 A2 BoolQ statistics and preregistered rules.
+
+No artifacts are read here. ``counts`` maps each seed (3, 4, 5) to exact
+``(correct, total)`` pairs for SEG-04..07 and SEG-05/iv_swap. ``checks`` maps
+each seed to the diagnostic booleans and path-check observations documented
+in :data:`IMPLEMENTATION_CHECKS` and :data:`PATH_CHECKS`. ``base`` is the
+SEG-00 pair. ``intervals`` maps each seed and arm label to one binary outcome
+per paired A2 BoolQ row; its row order must be identical across every entry.
+The function returns exact Fraction-backed point estimates and the locked
+shared-row bootstrap intervals.
+"""
+from fractions import Fraction
+import math
+
+import numpy as np
+
+SEEDS = (3, 4, 5)
+ARMS = ('SEG-04', 'SEG-05', 'SEG-06', 'SEG-07')
+LABELS = (*ARMS, 'SEG-05/iv_swap')
+IMPLEMENTATION_CHECKS = (
+    'off_matches_base_dev',
+    'initial_matches_base_dev',
+    'no_channel_identity',
+    'reload_identical',
+    'initial_parameters_identical',
+    'train_ids_disjoint_a2',
+    'a2_ids_and_hashes_match',
+)
+PATH_CHECKS = ('path_dev_same_hardware', 'path_dev_mismatch_count', 'a2_iv_off_matches_base')
+BOOTSTRAP_REPEATS = 10_000
+BOOTSTRAP_SEED = 20261101
+MAX_DIFFERENT_HARDWARE_MISMATCHES = 10
+
+
+def number(value):
+    """Serialize an exact score/difference (unit accuracy) as a fraction and pp."""
+    return {'numerator': value.numerator, 'denominator': value.denominator,
+            'pp': float(100 * value)}
+
+
+def _fraction(pair, label):
+    if (not isinstance(pair, (tuple, list)) or len(pair) != 2 or
+            type(pair[0]) is not int or type(pair[1]) is not int or
+            pair[1] <= 0 or not 0 <= pair[0] <= pair[1]):
+        raise ValueError(f'invalid exact BoolQ counts for {label}')
+    return Fraction(pair[0], pair[1])
+
+
+def _seed_quantities(seed_counts):
+    if set(seed_counts) != set(LABELS):
+        raise ValueError('each seed needs SEG-04..07 and SEG-05/iv_swap')
+    totals = {pair[1] for pair in seed_counts.values() if isinstance(pair, (tuple, list)) and len(pair) == 2}
+    scores = {label: _fraction(pair, f'{label}') for label, pair in seed_counts.items()}
+    if len(totals) != 1:
+        raise ValueError('paired BoolQ row counts differ within a seed')
+    gain = scores['SEG-05'] - max(scores['SEG-06'], scores['SEG-07'])
+    lora = scores['SEG-05'] - scores['SEG-04']
+    swap = scores['SEG-05'] - scores['SEG-05/iv_swap']
+    return scores, gain, lora, swap
+
+
+def _validate_intervals(intervals, totals):
+    if set(intervals) != set(SEEDS):
+        raise ValueError('bootstrap outcomes are required for seeds 3, 4 and 5')
+    binary = {}
+    row_count = None
+    for seed in SEEDS:
+        if set(intervals[seed]) != set(LABELS):
+            raise ValueError(f'seed {seed} bootstrap outcomes need SEG-04..07 and iv_swap')
+        binary[seed] = {}
+        for label in LABELS:
+            values = np.asarray(intervals[seed][label])
+            if values.ndim != 1 or values.size != totals[seed]:
+                raise ValueError('bootstrap vectors must be one-dimensional and match count totals')
+            if values.dtype.kind not in 'biu' or np.any((values != 0) & (values != 1)):
+                raise ValueError('bootstrap outcomes must contain only binary integer values')
+            if row_count is None:
+                row_count = values.size
+            elif values.size != row_count:
+                raise ValueError('all arms and seeds must share the same paired row count')
+            binary[seed][label] = values.astype(np.int64, copy=False)
+    return binary, row_count
+
+
+def _bootstrap(binary, row_count):
+    """Paired BoolQ bootstrap with one shared draw matrix and per-draw max control."""
+    rng = np.random.default_rng(BOOTSTRAP_SEED)
+    g = np.empty(BOOTSTRAP_REPEATS, dtype=np.float64)
+    l = np.empty(BOOTSTRAP_REPEATS, dtype=np.float64)
+    # Chunking bounds memory while consuming the same Generator stream as a
+    # single (repeats, rows) integer draw.
+    cursor = 0
+    while cursor < BOOTSTRAP_REPEATS:
+        end = min(cursor + 128, BOOTSTRAP_REPEATS)
+        indices = rng.integers(0, row_count, size=(end - cursor, row_count))
+        seed_gain_counts = np.zeros(end - cursor, dtype=np.int64)
+        seed_lora_counts = np.zeros(end - cursor, dtype=np.int64)
+        for seed in SEEDS:
+            correct = {arm: binary[seed][arm][indices].sum(axis=1) for arm in ARMS}
+            seed_gain_counts += correct['SEG-05'] - np.maximum(correct['SEG-06'], correct['SEG-07'])
+            seed_lora_counts += correct['SEG-05'] - correct['SEG-04']
+        denominator = len(SEEDS) * row_count
+        g[cursor:end] = seed_gain_counts / denominator
+        l[cursor:end] = seed_lora_counts / denominator
+        cursor = end
+    return {
+        'G': [float(x) for x in np.quantile(g, [0.025, 0.975])],
+        'L': [float(x) for x in np.quantile(l, [0.025, 0.975])],
+    }
+
+
+def _check_bool(checks, seed, name):
+    return checks[seed].get(name) is True
+
+
+def analyze(counts, checks, base, intervals):
+    """Apply E-0030 rules to exact BoolQ counts and paired row outcomes.
+
+    Diagnostic input keys per seed are the seven :data:`IMPLEMENTATION_CHECKS`
+    plus the three :data:`PATH_CHECKS`. The path mismatch count is an integer:
+    same hardware requires zero mismatches; different hardware permits at most
+    ten. Caller supplies the iv_off/Base identity result as a boolean.
+    """
+    if set(counts) != set(SEEDS) or set(checks) != set(SEEDS):
+        raise ValueError('E-0030 requires counts and checks for seeds 3, 4 and 5')
+    quantities = {}
+    totals = {}
+    for seed in SEEDS:
+        scores, gain, lora, swap = _seed_quantities(counts[seed])
+        quantities[seed] = {'scores': scores, 'gain': gain, 'lora': lora, 'swap': swap}
+        totals[seed] = next(iter(counts[seed].values()))[1]
+    base_score = _fraction(base, 'SEG-00 Base_seg')
+    if any(totals[s] != base[1] for s in SEEDS):
+        raise ValueError('Base_seg row count differs from arm rows')
+    binary, row_count = _validate_intervals(intervals, totals)
+    if any(row_count != totals[s] for s in SEEDS):
+        raise ValueError('bootstrap row count differs from point-count rows')
+    for seed in SEEDS:
+        for label in LABELS:
+            if int(binary[seed][label].sum()) != counts[seed][label][0]:
+                raise ValueError(f'bootstrap outcomes disagree with exact correct count for seed {seed} {label}')
+
+    implementation = {}
+    path = {}
+    for seed in SEEDS:
+        c = checks[seed]
+        mismatch_count = c.get('path_dev_mismatch_count')
+        if type(mismatch_count) is not int or mismatch_count < 0:
+            raise ValueError(f'seed {seed} path_dev_mismatch_count must be a nonnegative integer')
+        if type(c.get('path_dev_same_hardware')) is not bool:
+            raise ValueError(f'seed {seed} path_dev_same_hardware must be boolean')
+        same_hardware = c.get('path_dev_same_hardware') is True
+        dev_ok = mismatch_count == 0 if same_hardware else mismatch_count <= MAX_DIFFERENT_HARDWARE_MISMATCHES
+        implementation[seed] = {name: _check_bool(checks, seed, name) for name in IMPLEMENTATION_CHECKS}
+        path[seed] = {
+            'dev_reproduction': bool(dev_ok),
+            'path_dev_same_hardware': same_hardware,
+            'path_dev_mismatch_count': mismatch_count,
+            'a2_iv_off_matches_base': _check_bool(checks, seed, 'a2_iv_off_matches_base'),
+        }
+    implementation_ok = all(all(v.values()) for v in implementation.values())
+    path_ok = all(v['dev_reproduction'] and v['a2_iv_off_matches_base'] for v in path.values())
+
+    G = sum((quantities[s]['gain'] for s in SEEDS), Fraction()) / len(SEEDS)
+    L = sum((quantities[s]['lora'] for s in SEEDS), Fraction()) / len(SEEDS)
+    W = sum((quantities[s]['swap'] for s in SEEDS), Fraction()) / len(SEEDS)
+    ci = _bootstrap(binary, row_count)
+    # The threshold comparison is strict, as preregistered.
+    g_lower_positive = ci['G'][0] > 0
+    supported = G > 0 and g_lower_positive
+    challenged = G <= 0
+    direction = ('invalid_implementation' if not implementation_ok or not path_ok else
+                 'supported' if supported else 'challenged' if challenged else 'inconclusive')
+    secondary_confirmed = direction == 'supported' and L > 0 and ci['L'][0] > 0
+
+    threshold = base_score + Fraction(1, 100)
+    learned = {s: {a: quantities[s]['scores'][a] >= threshold for a in ARMS} for s in SEEDS}
+    unlearned_controls = {s: not learned[s]['SEG-06'] and not learned[s]['SEG-07'] for s in SEEDS}
+    per_seed = {str(s): {
+        'gain': number(quantities[s]['gain']),
+        'lora': number(quantities[s]['lora']),
+        'swap': number(quantities[s]['swap']),
+        'boolq': {label: number(score) for label, score in quantities[s]['scores'].items()},
+    } for s in SEEDS}
+    gains = [quantities[s]['gain'] for s in SEEDS]
+    gain_sd = math.sqrt(sum(float((x - G) ** 2) for x in gains) / len(gains))
+    rules = {
+        '1': {'level': 'diagnostic', 'passed': implementation_ok, 'checks': {str(s): implementation[s] for s in SEEDS},
+              'action': 'interpret' if implementation_ok else 'repair_no_conclusion'},
+        '2': {'level': 'diagnostic', 'passed': path_ok, 'checks': {str(s): path[s] for s in SEEDS},
+              'action': 'interpret' if path_ok else 'invalid_a2_no_conclusion'},
+        '3': {'level': 'descriptive', 'per_seed': per_seed, 'G': number(G), 'L': number(L), 'W': number(W),
+              'gain_positive_seed_count': sum(x > 0 for x in gains),
+              'gain_seed_sd_population': gain_sd,
+              'weights': 'equal over seeds 3,4,5'},
+        '4': {'level': 'descriptive', 'bootstrap': {'method': 'paired BoolQ row bootstrap',
+              'repeats': BOOTSTRAP_REPEATS, 'seed': BOOTSTRAP_SEED, 'shared_indices': True,
+              'max_control_recomputed_each_draw': True, 'quantile': 'numpy linear default',
+              'G_ci95': ci['G'], 'L_ci95': ci['L']}},
+        '5': {'level': 'confirmatory', 'outcome': direction if direction != 'invalid_implementation' else 'not_evaluated',
+              'G_positive': G > 0, 'G_ci_lower_positive': g_lower_positive,
+              'challenged_G_nonpositive': G <= 0},
+        '6': {'level': 'confirmatory' if direction == 'supported' else 'descriptive',
+              'evaluated': direction == 'supported', 'confirmed': secondary_confirmed,
+              'L_positive': L > 0, 'L_ci_lower_positive': ci['L'][0] > 0,
+              'reason': 'confirmed' if secondary_confirmed else
+                        'fixed_sequence_not_reached' if direction != 'supported' else 'criterion_not_met'},
+        '7': {'level': 'descriptive', 'threshold': number(threshold),
+              'learned': {str(s): learned[s] for s in SEEDS},
+              'no_history_r128_controls_unlearned': {str(s): unlearned_controls[s] for s in SEEDS},
+              'mean_mainly_one_seed': direction == 'supported' and sum(x > 0 for x in gains) < 2},
+        '8': {'level': 'descriptive', 'other_metrics': 'PIQA, macro, NLL, and dev comparisons supplied/reported by caller',
+              'hypothesis_status_changed': False},
+    }
+    return {'rules': rules, 'direction': direction,
+            'eligible_edge': direction if direction in ('supported', 'challenged') else None,
+            'secondary_confirmed': secondary_confirmed, 'G': number(G), 'L': number(L), 'W': number(W),
+            'ci95': {'G': ci['G'], 'L': ci['L']}, 'per_seed': per_seed}
