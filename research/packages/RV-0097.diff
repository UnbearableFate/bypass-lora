+        data[seed]['SEG-05'] = np.ones(n, dtype=np.int8)
+        data[seed]['SEG-04'] = np.ones(n, dtype=np.int8)
+    intervals = rules._bootstrap(data, n)
+    assert intervals['G'] == [0.0, 0.0]
+    assert intervals['L'] == [0.0, 0.0]
