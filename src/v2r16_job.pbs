#!/bin/bash
set -euo pipefail
: "${SR_CODE_COMMIT:?registered commit required}"
: "${SR_ATTEMPT_ID:?registered attempt required}"
: "${SR_SPEC_DIGEST:?registered spec digest required}"
R16_PROJECT=/work/xg24i002/x10041/bypass-lora
R16_SOURCE="$R16_PROJECT/snapshots/$SR_CODE_COMMIT"
R16_OUTPUT="$R16_PROJECT/runs/$SR_ATTEMPT_ID"
R16_PYTHON="$R16_PROJECT/envs/3c916b51337d-cuda/bin/python"
mkdir -p "$R16_OUTPUT"
/work/xg24i002/x10041/miyabi-toolbox/miyabi-mcp/bin/miyabi-mcp \
  --project-dir "$R16_PROJECT" call allocation_check '{"target_system":"Miyabi-G"}' \
  > "$R16_OUTPUT/allocation.json"
/usr/bin/jq -e '.ok == true' "$R16_OUTPUT/allocation.json"
source /etc/profile.d/modules.sh
module load cuda/12.8
export HF_HOME=/work/xg24i002/x10041/hf_home HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export PYTHONPATH="$R16_SOURCE/src"
export TMPDIR="/local/${PBS_JOBID}/v2r16"
mkdir -p "$TMPDIR"
cd "$R16_SOURCE"
if [[ "${R16_STAGE:-smoke}" == smoke ]]; then
  exec "$R16_PYTHON" src/v2r16_smoke.py --output "$R16_OUTPUT"
fi
: "${R16_ARM:?formal arm required}"
R16_ARGS=()
if [[ -n "${R16_CHECKPOINT:-}" ]]; then
  R16_ARGS+=(--checkpoint "$R16_CHECKPOINT")
fi
exec "$R16_PYTHON" src/v2r16_launch.py --arm "$R16_ARM" --output "$R16_OUTPUT" "${R16_ARGS[@]}"
